digraph G {
graph [rankdir=TB, nodesep=0.2, ranksep=0.34, fontname="Arial", fontsize=14, pad=0.08, dpi=200, newrank=true];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=14, arrowsize=0.9, penwidth=1.1];
labelloc="t"; labeljust="l"; label=<<B><FONT POINT-SIZE="16">UC-03 Maintain hubs and kitchen capacity</FONT></B><BR ALIGN="LEFT"/><B><FONT POINT-SIZE="14">Final design class diagram, detail sheet A: HubController</FONT></B><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">Owner 722I0004 · Author 722I0004 · AI-assisted (Claude)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#4A5663">grey dashed: calls or uses</FONT>    <FONT POINT-SIZE="14" COLOR="#7A4FA0">purple dashed: «persists» (DAO writes the entity)</FONT>    <BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#00796B">teal dotted: «loads» (DAO only reads it)</FONT>    <BR ALIGN="LEFT"/>>;
subgraph cluster_view { label=<<B>View layer (Flask blueprint functions)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "bp_admin"; }
  "bp_admin" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FA" CELLPADDING="3"><FONT POINT-SIZE="14">«boundary»</FONT><BR/><FONT POINT-SIZE="14"><B>admin views</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ archive_hub() POST /admin/hubs/&lt;int:hub_id&gt;/archive</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ edit_hub() GET/POST /admin/hubs/&lt;int:hub_id&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ hubs() GET /admin/hubs</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ new_hub() GET/POST /admin/hubs/new</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_controller { label=<<B>Controller layer</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "HubController"; }
  "HubController" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#EAF5EA" CELLPADDING="3"><FONT POINT-SIZE="14">«control»</FONT><BR/><FONT POINT-SIZE="14"><B>HubController</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ archive_hub(user_id: int, hub_id: int): Hub</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ create_hub(user_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;form:&#160;Mapping[str,&#160;str]):&#160;Hub</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ get_hub(user_id: int, hub_id: int): HubAdminView</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ list_hubs(user_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;include_archived:&#160;bool):&#160;list[HubAdminView]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ update_hub(user_id: int, hub_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;form:&#160;Mapping[str,&#160;str]):&#160;Hub</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
"bp_admin" -> "HubController" [style=invis];
subgraph cluster_dao { label=<<B>Data access layer</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "HubDAO"; "UserDAO"; }
  "HubDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" CELLPADDING="3"><FONT POINT-SIZE="14">«DAO»</FONT><BR/><FONT POINT-SIZE="14"><B>HubDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ active_load(hub_id: int): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ active_loads(): dict[int, int]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ archive(hub_id: int, now: str): bool</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ code_exists(code: str,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;except_id:&#160;int&#160;|&#160;None):&#160;bool</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ get_including_archived(hub_id: int): Hub | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ insert(hub: Hub): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ list_all(): list[Hub]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ open_order_count(hub_id: int): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ update(hub: Hub): bool</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "UserDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" CELLPADDING="3"><FONT POINT-SIZE="14">«DAO»</FONT><BR/><FONT POINT-SIZE="14"><B>UserDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ get_by_id(user_id: int): UserAccount | None</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
"HubController" -> "HubDAO" [style=invis];
subgraph cluster_domain { label=<<B>Domain layer (entities and value objects)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "Hub"; "Order"; "UserAccount"; }
  "Hub" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="3"><FONT POINT-SIZE="14">«entity»</FONT><BR/><FONT POINT-SIZE="14"><B>Hub</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="14">id: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">code: str</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">name: str</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">address_text: str</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">latitude: float</FONT><BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="14">longitude: float</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">max_active_orders: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">base_delivery_fee: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">archived_at: str | None</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
  "Order" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="3"><FONT POINT-SIZE="14">«entity»</FONT><BR/><FONT POINT-SIZE="14"><B>Order</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="14">state: OrderState</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">id: int | None</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
  "UserAccount" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="3"><FONT POINT-SIZE="14">«entity»</FONT><BR/><FONT POINT-SIZE="14"><B>UserAccount</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="14">id: int</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
}
"HubDAO" -> "Hub" [style=invis];
"HubController" -> "HubDAO" [style=dashed, arrowhead=vee, color="#4A5663"];
"HubController" -> "UserDAO" [style=dashed, arrowhead=vee, color="#4A5663"];
"HubDAO" -> "Hub" [style=dashed, arrowhead=vee, color="#7A4FA0", fontcolor="#7A4FA0", xlabel="«persists»"];
"HubDAO" -> "Order" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
"UserDAO" -> "UserAccount" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
"bp_admin" -> "HubController" [style=dashed, arrowhead=vee, color="#4A5663"];
}