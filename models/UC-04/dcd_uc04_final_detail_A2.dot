digraph G {
graph [rankdir=TB, nodesep=0.2, ranksep=0.34, fontname="Arial", fontsize=14, pad=0.08, dpi=200, newrank=true];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=14, arrowsize=0.9, penwidth=1.1];
labelloc="t"; labeljust="l"; label=<<B><FONT POINT-SIZE="16">UC-04 Produce management reports</FONT></B><BR ALIGN="LEFT"/><B><FONT POINT-SIZE="14">Final design class diagram, detail sheet A2: ReportController, data access</FONT></B><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">Owner 523K0049 · Author 722I0004 · AI-assisted (Claude)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#4A5663">grey dashed: calls or uses</FONT>    <FONT POINT-SIZE="14" COLOR="#7A4FA0">purple dashed: «persists» (DAO writes the entity)</FONT>    <FONT POINT-SIZE="14" COLOR="#00796B">teal dotted: «loads» (DAO only reads it)</FONT>    <BR ALIGN="LEFT"/>>;
subgraph cluster_controller { label=<<B>Controller layer («control», «value»)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "DeliveryRow"; "ReportController"; "SalesRow"; }
  "DeliveryRow" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF5EA"><TR><TD><FONT POINT-SIZE="14"><B>DeliveryRow</B></FONT></TD></TR></TABLE>>];
  "ReportController" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF5EA"><TR><TD><FONT POINT-SIZE="14"><B>ReportController</B></FONT></TD></TR></TABLE>>];
  "SalesRow" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF5EA"><TR><TD><FONT POINT-SIZE="14"><B>SalesRow</B></FONT></TD></TR></TABLE>>];
}
subgraph cluster_dao { label=<<B>Data access layer</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "HubDAO"; "ReportDAO"; }
  { rank=same; "UserDAO"; }
  "HubDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" CELLPADDING="3"><FONT POINT-SIZE="14">«DAO»</FONT><BR/><FONT POINT-SIZE="14"><B>HubDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ get_including_archived(hub_id: int): Hub | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ list_all(): list[Hub]</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ReportDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" CELLPADDING="3"><FONT POINT-SIZE="14">«DAO»</FONT><BR/><FONT POINT-SIZE="14"><B>ReportDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ finished_deliveries(start_utc: str,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;end_utc:&#160;str,&#160;hub_id:&#160;int&#160;|&#160;None):&#160;list[sqlite3.Row]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ open_orders_by_hub_and_state(): list[sqlite3.Row]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ sales_by_hub(start_utc: str, end_utc: str,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;hub_id:&#160;int&#160;|&#160;None):&#160;list[sqlite3.Row]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ top_items(start_utc: str, end_utc: str,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;hub_id:&#160;int&#160;|&#160;None,&#160;limit:&#160;int):&#160;list[sqlite3.Row]</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "UserDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" CELLPADDING="3"><FONT POINT-SIZE="14">«DAO»</FONT><BR/><FONT POINT-SIZE="14"><B>UserDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ get_by_id(user_id: int): UserAccount | None</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
"DeliveryRow" -> "HubDAO" [style=invis];
"HubDAO" -> "UserDAO" [style=invis];
subgraph cluster_domain { label=<<B>Domain layer («entity»)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  "Delivery" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>Delivery</B></FONT></TD></TR></TABLE>>];
  "Hub" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>Hub</B></FONT></TD></TR></TABLE>>];
  "HubStatus" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>HubStatus</B></FONT></TD></TR></TABLE>>];
  "Order" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>Order</B></FONT></TD></TR></TABLE>>];
  "OrderLine" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>OrderLine</B></FONT></TD></TR></TABLE>>];
  "Payment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>Payment</B></FONT></TD></TR></TABLE>>];
  "UserAccount" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>UserAccount</B></FONT></TD></TR></TABLE>>];
}
"UserDAO" -> "Delivery" [style=invis];
"UserDAO" -> "Hub" [style=invis];
"UserDAO" -> "HubStatus" [style=invis];
"UserDAO" -> "Order" [style=invis];
"UserDAO" -> "OrderLine" [style=invis];
"UserDAO" -> "Payment" [style=invis];
"UserDAO" -> "UserAccount" [style=invis];
"HubDAO" -> "Hub" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
"ReportController" -> "DeliveryRow" [style=dashed, arrowhead=vee, color="#4A5663"];
"ReportController" -> "HubDAO" [style=dashed, arrowhead=vee, color="#4A5663"];
"ReportController" -> "HubStatus" [style=dashed, arrowhead=vee, color="#4A5663"];
"ReportController" -> "ReportDAO" [style=dashed, arrowhead=vee, color="#4A5663"];
"ReportController" -> "SalesRow" [style=dashed, arrowhead=vee, color="#4A5663"];
"ReportController" -> "UserDAO" [style=dashed, arrowhead=vee, color="#4A5663"];
"ReportDAO" -> "Delivery" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
"ReportDAO" -> "Hub" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
"ReportDAO" -> "Order" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
"ReportDAO" -> "OrderLine" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
"ReportDAO" -> "Payment" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
"ReportDAO" -> "UserAccount" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
"UserDAO" -> "UserAccount" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
}