digraph G {
graph [rankdir=LR, nodesep=0.2, ranksep=0.34, fontname="Arial", fontsize=14, pad=0.08, dpi=200, newrank=true];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=14, arrowsize=0.9, penwidth=1.1];
labelloc="t"; labeljust="l"; label=<<B><FONT POINT-SIZE="16">UC-05 Decide an incoming order</FONT></B><BR ALIGN="LEFT"/><B><FONT POINT-SIZE="14">Final design class diagram, detail sheet A1: KitchenController, view and controller</FONT></B><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">Owner 523K0050 · Author 722I0004 · AI-assisted (Claude)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#4A5663">grey dashed: calls or uses</FONT>    <BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#7A4FA0">purple dashed: «persists» (DAO writes the entity)</FONT>    <BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#00796B">teal dotted: «loads» (DAO only reads it)</FONT>    <BR ALIGN="LEFT"/>>;
subgraph cluster_view { label=<<B>View layer (Flask blueprint functions)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "bp_kitchen"; }
  "bp_kitchen" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FA" CELLPADDING="3"><FONT POINT-SIZE="14">«boundary»</FONT><BR/><FONT POINT-SIZE="14"><B>kitchen views</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ board() GET /kitchen/</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ confirm() POST /kitchen/orders/&lt;int:order_id&gt;/confirm</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ offer() POST /kitchen/orders/&lt;int:order_id&gt;/offer</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ order() GET /kitchen/orders/&lt;int:order_id&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ reject() POST /kitchen/orders/&lt;int:order_id&gt;/reject</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_controller { label=<<B>Controller layer</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "KitchenController"; }
  "KitchenController" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#EAF5EA" CELLPADDING="3"><FONT POINT-SIZE="14">«control»</FONT><BR/><FONT POINT-SIZE="14"><B>KitchenController</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ board(user_id: int): KitchenBoard</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ confirm_order(user_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;order_id:&#160;int):&#160;Order</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ get_order(user_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;order_id:&#160;int):&#160;KitchenOrderView</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ offer_replacement(user_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;order_id:&#160;int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;order_line_id:&#160;int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;new_menu_item_id:&#160;int):&#160;ReplacementOffer</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ reject_order(user_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;order_id:&#160;int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;reason:&#160;str):&#160;Order</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
"bp_kitchen" -> "KitchenController" [style=invis];
"bp_kitchen" -> "KitchenController" [style=dashed, arrowhead=vee, color="#4A5663"];
}