digraph G {
graph [rankdir=TB, nodesep=0.2, ranksep=0.34, fontname="Arial", fontsize=14, pad=0.08, dpi=200, newrank=true];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=14, arrowsize=0.9, penwidth=1.1];
labelloc="t"; labeljust="l"; label=<<B><FONT POINT-SIZE="16">UC-05 Decide an incoming order</FONT></B><BR ALIGN="LEFT"/><B><FONT POINT-SIZE="14">Final design class diagram, detail sheet A2: KitchenController, controller and domain</FONT></B><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">Owner 523K0050 · Author 722I0004 · AI-assisted (Claude)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#4A5663">grey dashed: calls or uses</FONT>    <BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#7A4FA0">purple dashed: «persists» (DAO writes the entity)</FONT>    <BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#00796B">teal dotted: «loads» (DAO only reads it)</FONT>    <BR ALIGN="LEFT"/>>;
subgraph cluster_controller { label=<<B>Controller layer («control»)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "KitchenController"; }
  "KitchenController" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF5EA"><TR><TD><FONT POINT-SIZE="14"><B>KitchenController</B></FONT></TD></TR></TABLE>>];
}
subgraph cluster_domain { label=<<B>Domain layer (entities and value objects)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  "Order" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="3"><FONT POINT-SIZE="14">«entity»</FONT><BR/><FONT POINT-SIZE="14"><B>Order</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="14">state: OrderState</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">delivery_fee: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">idempotency_token: str</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">placed_at: str</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">lines: list[OrderLine]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">id: int | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">archived_at: str | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">delivery_address_text: str</FONT><BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="14">distance_km: float</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">voucher_discount: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">quiet_discount: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">reject_reason: str | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">confirmed_at: str | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">ready_at: str | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">closed_at: str | None</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ line(line_id: int): OrderLine | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ move_to(new_state: OrderState): None</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "Payment" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="3"><FONT POINT-SIZE="14">«entity»</FONT><BR/><FONT POINT-SIZE="14"><B>Payment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="14">method: PaymentMethod</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">state: PaymentState</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">amount: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">created_at: str</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">updated_at: str | None</FONT><BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="14">online_option: OnlineOption | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">provider_ref: str | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">refund_amount: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">id: int | None</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ release_for_unfulfilled_order(): None</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
"KitchenController" -> "Order" [style=invis];
"KitchenController" -> "Payment" [style=invis];
"KitchenController" -> "Order" [style=dashed, arrowhead=vee, color="#4A5663"];
"KitchenController" -> "Payment" [style=dashed, arrowhead=vee, color="#4A5663"];
}