        },
        {
          "id": "M06-A03",
          "operation": "updateBrand",
          "call": "updateBrand(brandId, name)",
          "return": "savedRecord | controlledRefusal",
          "guard": "[updateBrand]"
        },
        {
          "id": "M06-A04",
          "operation": "archiveBrand",
          "call": "archiveBrand(brandId)",
          "return": "savedRecord | controlledRefusal",
          "guard": "[archiveBrand]"
        }
      ],
      "note": "PC01 / PC03; MG01 / MG02. Name uniqueness includes retained archived names; archive blocks descendants.\nHistorical OrderLines stay unchanged. AVAILABLE never overrides an archived parent."
