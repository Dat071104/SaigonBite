digraph G {
graph [rankdir=TB, nodesep=0.2, ranksep=0.34, fontname="Arial", fontsize=14, pad=0.08, dpi=200, newrank=true];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=14, arrowsize=0.9, penwidth=1.1];
labelloc="t"; labeljust="l"; label=<<B><FONT POINT-SIZE="16">UC-06 Maintain brands, menu items and hub listings</FONT></B><BR ALIGN="LEFT"/><B><FONT POINT-SIZE="14">Final design class diagram, detail sheet A2: MenuController, data access</FONT></B><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">Owner 523K0050 · Author 722I0004 · AI-assisted (Claude)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#4A5663">grey dashed: calls or uses</FONT>    <FONT POINT-SIZE="14" COLOR="#7A4FA0">purple dashed: «persists» (DAO writes the entity)</FONT>    <BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#00796B">teal dotted: «loads» (DAO only reads it)</FONT>    <BR ALIGN="LEFT"/>>;
subgraph cluster_controller { label=<<B>Controller layer («control»)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "MenuController"; }
  "MenuController" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF5EA"><TR><TD><FONT POINT-SIZE="14"><B>MenuController</B></FONT></TD></TR></TABLE>>];
}
subgraph cluster_dao { label=<<B>Data access layer</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "HubDAO"; }
  { rank=same; "MenuDAO"; }
  { rank=same; "UserDAO"; }
  "HubDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" CELLPADDING="3"><FONT POINT-SIZE="14">«DAO»</FONT><BR/><FONT POINT-SIZE="14"><B>HubDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ get_including_archived(hub_id: int): Hub | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ list_all(): list[Hub]</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "MenuDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" CELLPADDING="3"><FONT POINT-SIZE="14">«DAO»</FONT><BR/><FONT POINT-SIZE="14"><B>MenuDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ add_listing(hub_id: int, item_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;available:&#160;bool):&#160;None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ archive_brand(brand_id: int, now: str): bool</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ archive_item(item_id: int, now: str): bool</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ brand_name_exists(name: str, except_id: int | None): bool</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ get_brand(brand_id: int): Brand | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ get_item(item_id: int): MenuItem | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ insert_brand(name: str): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ insert_item(item: MenuItem): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ is_listed(hub_id: int, item_id: int): bool</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ item_name_exists(brand_id: int, name: str,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;except_id:&#160;int&#160;|&#160;None):&#160;bool</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ list_brands(): list[Brand]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ list_hub_items(hub_id: int): list[HubMenuItem]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ list_items(): list[MenuItem]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ remove_listing(hub_id: int, item_id: int): bool</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ rename_brand(brand_id: int, name: str): bool</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ set_available(hub_id: int, item_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;available:&#160;bool):&#160;bool</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ update_item(item: MenuItem): bool</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "UserDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" CELLPADDING="3"><FONT POINT-SIZE="14">«DAO»</FONT><BR/><FONT POINT-SIZE="14"><B>UserDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ get_by_id(user_id: int): UserAccount | None</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
"MenuController" -> "HubDAO" [style=invis];
"HubDAO" -> "MenuDAO" [style=invis];
"MenuDAO" -> "UserDAO" [style=invis];
subgraph cluster_domain { label=<<B>Domain layer («entity»)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "Brand"; "Hub"; "HubMenuItem"; "MenuItem"; "UserAccount"; }
  "Brand" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>Brand</B></FONT></TD></TR></TABLE>>];
  "Hub" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>Hub</B></FONT></TD></TR></TABLE>>];
  "HubMenuItem" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>HubMenuItem</B></FONT></TD></TR></TABLE>>];
  "MenuItem" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>MenuItem</B></FONT></TD></TR></TABLE>>];
  "UserAccount" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>UserAccount</B></FONT></TD></TR></TABLE>>];
}
"UserDAO" -> "Brand" [style=invis];
"HubDAO" -> "Hub" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
"MenuController" -> "HubDAO" [style=dashed, arrowhead=vee, color="#4A5663"];
"MenuController" -> "MenuDAO" [style=dashed, arrowhead=vee, color="#4A5663"];
"MenuController" -> "UserDAO" [style=dashed, arrowhead=vee, color="#4A5663"];
"MenuDAO" -> "Brand" [style=dashed, arrowhead=vee, color="#7A4FA0", fontcolor="#7A4FA0", xlabel="«persists»"];
"MenuDAO" -> "HubMenuItem" [style=dashed, arrowhead=vee, color="#7A4FA0", fontcolor="#7A4FA0", xlabel="«persists»"];
"MenuDAO" -> "MenuItem" [style=dashed, arrowhead=vee, color="#7A4FA0", fontcolor="#7A4FA0", xlabel="«persists»"];
"UserDAO" -> "UserAccount" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
}