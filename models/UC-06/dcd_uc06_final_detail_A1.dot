digraph G {
graph [rankdir=TB, nodesep=0.2, ranksep=0.34, fontname="Arial", fontsize=14, pad=0.08, dpi=200, newrank=true];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=14, arrowsize=0.9, penwidth=1.1];
labelloc="t"; labeljust="l"; label=<<B><FONT POINT-SIZE="16">UC-06 Maintain brands, menu items and hub listings</FONT></B><BR ALIGN="LEFT"/><B><FONT POINT-SIZE="14">Final design class diagram, detail sheet A1: MenuController, view, controller and domain</FONT></B><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">Owner 523K0050 · Author 722I0004 · AI-assisted (Claude)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#4A5663">grey dashed: calls or uses</FONT>    <BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#7A4FA0">purple dashed: «persists» (DAO writes the entity)</FONT>    <BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#00796B">teal dotted: «loads» (DAO only reads it)</FONT>    <BR ALIGN="LEFT"/>>;
subgraph cluster_view { label=<<B>View layer (Flask blueprint functions)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "bp_admin"; }
  "bp_admin" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FA" CELLPADDING="3"><FONT POINT-SIZE="14">«boundary»</FONT><BR/><FONT POINT-SIZE="14"><B>admin views</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ archive_brand() POST /admin/brands/&lt;int:brand_id&gt;/archive</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ archive_item() POST /admin/items/&lt;int:item_id&gt;/archive</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ catalogue() GET /admin/menu</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ create_brand() POST /admin/brands</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ edit_item() GET/POST /admin/items/&lt;int:item_id&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ hub_item_availability() POST /admin/hubs/&lt;int:hub_id&gt;/menu/&lt;int:item_id&gt;/availability</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ hub_menu() GET /admin/hubs/&lt;int:hub_id&gt;/menu</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ list_item() POST /admin/hubs/&lt;int:hub_id&gt;/menu</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ new_item() GET/POST /admin/items/new</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ rename_brand() POST /admin/brands/&lt;int:brand_id&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ unlist_item() POST /admin/hubs/&lt;int:hub_id&gt;/menu/&lt;int:item_id&gt;/remove</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_controller { label=<<B>Controller layer</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "MenuController"; }
  "MenuController" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#EAF5EA" CELLPADDING="3"><FONT POINT-SIZE="14">«control»</FONT><BR/><FONT POINT-SIZE="14"><B>MenuController</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ archive_brand(user_id: int, brand_id: int): Brand</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ archive_item(user_id: int, item_id: int): MenuItem</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ create_brand(user_id: int, name: str): Brand</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ create_item(user_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;form:&#160;Mapping[str,&#160;str]):&#160;MenuItem</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ list_catalogue(user_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;hub_id:&#160;int&#160;|&#160;None):&#160;dict[str,&#160;object]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ list_item_at_hub(user_id: int, hub_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;item_id:&#160;int,&#160;available:&#160;bool):&#160;None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ rename_brand(user_id: int, brand_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;name:&#160;str):&#160;Brand</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ set_availability(user_id: int, hub_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;item_id:&#160;int,&#160;available:&#160;bool):&#160;None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ unlist_item_at_hub(user_id: int, hub_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;item_id:&#160;int):&#160;None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ update_item(user_id: int, item_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;form:&#160;Mapping[str,&#160;str]):&#160;MenuItem</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
"bp_admin" -> "MenuController" [style=invis];
"bp_admin" -> "MenuController" [style=dashed, arrowhead=vee, color="#4A5663"];
}