        </mxCell>
        <mxCell id="text_3" value="&lt;div&gt;S − D + F − Q = T (snapshots).&lt;br/&gt;ONLINE amount = captured C.&lt;br/&gt;refund_amount = owed, not paid.&lt;br/&gt;One OFFERED offer per Order.&lt;br/&gt;Offer/line share the same Order.&lt;br/&gt;REFUNDED/payout deferred (L3).&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#202B36;fontStyle=0;" vertex="1" parent="1">
