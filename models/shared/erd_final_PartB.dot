digraph ERD {
graph [rankdir=LR, nodesep=0.3, ranksep=0.7, fontname="Arial", fontsize=16, pad=0.2, dpi=200, labelloc="t",
 label=<<B>Schema v2 (db/schema.sql) — part B: Orders and their records</B><BR/><FONT POINT-SIZE="12">Author 722I0004 · AI-assisted (Claude) · PK primary key · FK foreign key · U unique · ? nullable · bar = one, crow's foot = many</FONT>>];
node [shape=plain, fontname="Arial", fontsize=13];
edge [color="#40505F", penwidth=1.2];
"orders" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" COLSPAN="2"><B>orders</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id">customer_id</TD><TD ALIGN="LEFT">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" PORT="hub_id">hub_id</TD><TD ALIGN="LEFT">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" PORT="address_id">address_id</TD><TD ALIGN="LEFT">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" PORT="delivery_address_text">delivery_address_text</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="distance_km">distance_km</TD><TD ALIGN="LEFT">REAL </TD></TR><TR><TD ALIGN="LEFT" PORT="state">state</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="item_subtotal">item_subtotal</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="voucher_id">voucher_id ?</TD><TD ALIGN="LEFT">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" PORT="voucher_discount">voucher_discount</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="delivery_fee">delivery_fee</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="quiet_discount">quiet_discount</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount">total_amount</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="idempotency_token">idempotency_token</TD><TD ALIGN="LEFT">TEXT U</TD></TR><TR><TD ALIGN="LEFT" PORT="reject_reason">reject_reason ?</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="placed_at">placed_at</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="confirmed_at">confirmed_at ?</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="ready_at">ready_at ?</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="closed_at">closed_at ?</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="archived_at">archived_at ?</TD><TD ALIGN="LEFT">TEXT </TD></TR></TABLE>>];
"order_line" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" COLSPAN="2"><B>order_line</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" PORT="order_id">order_id</TD><TD ALIGN="LEFT">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" PORT="menu_item_id">menu_item_id</TD><TD ALIGN="LEFT">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" PORT="item_name">item_name</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity</TD><TD ALIGN="LEFT">INTEGER </TD></TR></TABLE>>];
"payment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" COLSPAN="2"><B>payment</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" PORT="order_id">order_id</TD><TD ALIGN="LEFT">INTEGER FK U</TD></TR><TR><TD ALIGN="LEFT" PORT="method">method</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="online_option">online_option ?</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="provider_ref">provider_ref ?</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="state">state</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="amount">amount</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="refund_amount">refund_amount</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT">TEXT </TD></TR></TABLE>>];
"delivery" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" COLSPAN="2"><B>delivery</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" PORT="order_id">order_id</TD><TD ALIGN="LEFT">INTEGER FK U</TD></TR><TR><TD ALIGN="LEFT" PORT="shipper_id">shipper_id ?</TD><TD ALIGN="LEFT">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" PORT="state">state</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="ready_at">ready_at</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="picked_up_at">picked_up_at ?</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="finished_at">finished_at ?</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="failure_reason">failure_reason ?</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="cash_collected">cash_collected ?</TD><TD ALIGN="LEFT">INTEGER </TD></TR></TABLE>>];
"replacement_offer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" COLSPAN="2"><B>replacement_offer</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" PORT="order_id">order_id</TD><TD ALIGN="LEFT">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" PORT="order_line_id">order_line_id</TD><TD ALIGN="LEFT">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" PORT="original_item_name">original_item_name</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="original_unit_price">original_unit_price</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="new_menu_item_id">new_menu_item_id</TD><TD ALIGN="LEFT">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" PORT="new_item_name">new_item_name</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="new_unit_price">new_unit_price</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="state">state</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="offered_at">offered_at</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="decided_at">decided_at ?</TD><TD ALIGN="LEFT">TEXT </TD></TR></TABLE>>];
"voucher" [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#EEEEEE"><TR><TD><I>voucher</I><BR/><FONT POINT-SIZE="11">(part A)</FONT></TD></TR></TABLE>>];
"voucher" -> "orders":"voucher_id" [arrowhead=crow, arrowtail=tee, dir=both];
"address" [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#EEEEEE"><TR><TD><I>address</I><BR/><FONT POINT-SIZE="11">(part A)</FONT></TD></TR></TABLE>>];
"address" -> "orders":"address_id" [arrowhead=crow, arrowtail=tee, dir=both];
"hub" [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#EEEEEE"><TR><TD><I>hub</I><BR/><FONT POINT-SIZE="11">(part A)</FONT></TD></TR></TABLE>>];
"hub" -> "orders":"hub_id" [arrowhead=crow, arrowtail=tee, dir=both];
"customer" [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#EEEEEE"><TR><TD><I>customer</I><BR/><FONT POINT-SIZE="11">(part A)</FONT></TD></TR></TABLE>>];
"customer" -> "orders":"customer_id" [arrowhead=crow, arrowtail=tee, dir=both];
"menu_item" [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#EEEEEE"><TR><TD><I>menu_item</I><BR/><FONT POINT-SIZE="11">(part A)</FONT></TD></TR></TABLE>>];
"menu_item" -> "order_line":"menu_item_id" [arrowhead=crow, arrowtail=tee, dir=both];
"orders" -> "order_line":"order_id" [arrowhead=crow, arrowtail=tee, dir=both];
"orders" -> "payment":"order_id" [arrowhead=tee, arrowtail=tee, dir=both];
"user_account" [label=<<TABLE BORDER="1" CELLBORDER="0" BGCOLOR="#EEEEEE"><TR><TD><I>user_account</I><BR/><FONT POINT-SIZE="11">(part A)</FONT></TD></TR></TABLE>>];
"user_account" -> "delivery":"shipper_id" [arrowhead=crow, arrowtail=tee, dir=both];
"orders" -> "delivery":"order_id" [arrowhead=tee, arrowtail=tee, dir=both];
"menu_item" -> "replacement_offer":"new_menu_item_id" [arrowhead=crow, arrowtail=tee, dir=both];
"order_line" -> "replacement_offer":"order_line_id" [arrowhead=crow, arrowtail=tee, dir=both];
"orders" -> "replacement_offer":"order_id" [arrowhead=crow, arrowtail=tee, dir=both];
}