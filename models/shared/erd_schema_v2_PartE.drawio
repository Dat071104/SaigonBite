          <mxGeometry x="1302" y="762" width="282.5" height="65.0" as="geometry" />
        </mxCell>
        <mxCell id="text_24" value="&lt;div&gt;idx_offer_one_open is UNIQUE on order_id only WHERE state = &amp;#x27;OFFERED&amp;#x27;; all resolved offers remain history.&lt;br/&gt;SQL does not require offer.order_id to match order_line.order_id or recheck target eligibility at the same hub (P2-S09).&lt;br/&gt;Original/new names and prices are snapshots; only new_menu_item_id references the current target item.&lt;br/&gt;Offer timestamps are UTC. No withdrawal_reason column or separate Shipper table exists in schema v2.&lt;br/&gt;Continuation: Order and OrderLine resolve to PartC; target MenuItem resolves to PartB; payment history is in PartD.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#202B36;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="82" y="942" width="1366.03125" height="162.5" as="geometry" />
        </mxCell>
