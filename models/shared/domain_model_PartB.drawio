        </mxCell>
        <mxCell id="text_4" value="&lt;div&gt;Catalogue archive never rewrites order snapshots.&lt;br/&gt;Archived brand or item cannot be ordered.&lt;br/&gt;Hub details appear in Figure 2.2A.&lt;br/&gt;Voucher → Order appears in Figure 2.2C.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#202B36;fontStyle=0;" vertex="1" parent="1">
