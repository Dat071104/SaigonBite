        </mxCell>
        <mxCell id="text_5" value="&lt;div&gt;Quote, report filters/rows and receipts are computed views; they are not persistent classes.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#202B36;fontStyle=0;" vertex="1" parent="1">
