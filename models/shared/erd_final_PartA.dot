digraph ERD {
graph [rankdir=LR, nodesep=0.3, ranksep=0.7, fontname="Arial", fontsize=16, pad=0.2, dpi=200, labelloc="t",
 label=<<B>Schema v2 (db/schema.sql) — part A: People, hubs, catalogue and vouchers</B><BR/><FONT POINT-SIZE="12">Author 722I0004 · AI-assisted (Claude) · PK primary key · FK foreign key · U unique · ? nullable · bar = one, crow's foot = many</FONT>>];
node [shape=plain, fontname="Arial", fontsize=13];
edge [color="#40505F", penwidth=1.2];
"user_account" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FA" COLSPAN="2"><B>user_account</B></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" PORT="username">username</TD><TD ALIGN="LEFT">TEXT U</TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash">password_hash</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="display_name">display_name</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="role">role</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="hub_id">hub_id ?</TD><TD ALIGN="LEFT">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">is_active</TD><TD ALIGN="LEFT">INTEGER </TD></TR></TABLE>>];
"customer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FA" COLSPAN="2"><B>customer</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT">INTEGER FK U</TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="customer_type">customer_type</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone ?</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="email">email ?</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="passport_no">passport_no ?</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="nationality">nationality ?</TD><TD ALIGN="LEFT">TEXT </TD></TR></TABLE>>];
"address" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FA" COLSPAN="2"><B>address</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id">customer_id</TD><TD ALIGN="LEFT">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" PORT="label">label</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="full_address">full_address</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="district">district</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="latitude">latitude</TD><TD ALIGN="LEFT">REAL </TD></TR><TR><TD ALIGN="LEFT" PORT="longitude">longitude</TD><TD ALIGN="LEFT">REAL </TD></TR><TR><TD ALIGN="LEFT" PORT="archived_at">archived_at ?</TD><TD ALIGN="LEFT">TEXT </TD></TR></TABLE>>];
"hub" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FA" COLSPAN="2"><B>hub</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD ALIGN="LEFT">TEXT U</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="address_text">address_text</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="latitude">latitude</TD><TD ALIGN="LEFT">REAL </TD></TR><TR><TD ALIGN="LEFT" PORT="longitude">longitude</TD><TD ALIGN="LEFT">REAL </TD></TR><TR><TD ALIGN="LEFT" PORT="max_active_orders">max_active_orders</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="base_delivery_fee">base_delivery_fee</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="archived_at">archived_at ?</TD><TD ALIGN="LEFT">TEXT </TD></TR></TABLE>>];
"brand" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FA" COLSPAN="2"><B>brand</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT">TEXT U</TD></TR><TR><TD ALIGN="LEFT" PORT="archived_at">archived_at ?</TD><TD ALIGN="LEFT">TEXT </TD></TR></TABLE>>];
"menu_item" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FA" COLSPAN="2"><B>menu_item</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" PORT="brand_id">brand_id</TD><TD ALIGN="LEFT">INTEGER FK</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="price">price</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="archived_at">archived_at ?</TD><TD ALIGN="LEFT">TEXT </TD></TR></TABLE>>];
"hub_menu_item" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FA" COLSPAN="2"><B>hub_menu_item</B></TD></TR><TR><TD ALIGN="LEFT" PORT="hub_id">hub_id</TD><TD ALIGN="LEFT">INTEGER PK FK</TD></TR><TR><TD ALIGN="LEFT" PORT="menu_item_id">menu_item_id</TD><TD ALIGN="LEFT">INTEGER PK FK</TD></TR><TR><TD ALIGN="LEFT" PORT="is_available">is_available</TD><TD ALIGN="LEFT">INTEGER </TD></TR></TABLE>>];
"voucher" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FA" COLSPAN="2"><B>voucher</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">INTEGER PK</TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD ALIGN="LEFT">TEXT U</TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="discount_type">discount_type</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="discount_value">discount_value</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="min_subtotal">min_subtotal</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="max_discount">max_discount ?</TD><TD ALIGN="LEFT">INTEGER </TD></TR><TR><TD ALIGN="LEFT" PORT="valid_from">valid_from</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="valid_until">valid_until</TD><TD ALIGN="LEFT">TEXT </TD></TR><TR><TD ALIGN="LEFT" PORT="archived_at">archived_at ?</TD><TD ALIGN="LEFT">TEXT </TD></TR></TABLE>>];
"hub" -> "user_account":"hub_id" [arrowhead=crow, arrowtail=tee, dir=both];
"user_account" -> "customer":"user_id" [arrowhead=tee, arrowtail=tee, dir=both];
"customer" -> "address":"customer_id" [arrowhead=crow, arrowtail=tee, dir=both];
"brand" -> "menu_item":"brand_id" [arrowhead=crow, arrowtail=tee, dir=both];
"menu_item" -> "hub_menu_item":"menu_item_id" [arrowhead=crow, arrowtail=tee, dir=both];
"hub" -> "hub_menu_item":"hub_id" [arrowhead=crow, arrowtail=tee, dir=both];
}