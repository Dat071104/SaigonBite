        </mxCell>
        <mxCell id="text_1" value="&lt;div&gt;Figure 2.2A · Author: 722I0004 · AI-assisted (Codex)&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#202B36;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="1284" width="611.890625" height="32.5" as="geometry" />
        </mxCell>
        <mxCell id="text_2" value="&lt;div&gt;Analysis model · team defaults; no lecturer approval or runtime result inferred&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#202B36;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="1315" width="896.453125" height="32.5" as="geometry" />
        </mxCell>
        <mxCell id="text_3" value="&lt;div&gt;Customer: {complete, disjoint}.&lt;br/&gt;One CUSTOMER account per customer.&lt;br/&gt;Other roles have no Customer profile.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#202B36;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="740" y="315" width="475.578125" height="97.5" as="geometry" />
        </mxCell>
        <mxCell id="text_4" value="&lt;div&gt;Shipper is a UserAccount role (SHIPPER), not another class.&lt;br/&gt;A kitchen account has exactly one Hub; all other roles have none.&lt;br/&gt;Busy / quiet / workload are derived, never persisted Hub states.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#202B36;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="640" y="970" width="760.765625" height="97.5" as="geometry" />
        </mxCell>
        <mxCell id="text_5" value="&lt;div&gt;? = optional value; money = Integer whole VND.&lt;br/&gt;Dates use Date; timestamps use DateTime (UTC).&lt;br/&gt;No methods or foreign-key attributes appear in this analysis model.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#202B36;fontStyle=0;" vertex="1" parent="1">
