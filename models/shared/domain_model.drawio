        </mxCell>
        <mxCell id="text_3" value="&lt;div&gt;HubMenuItem is the association class of&lt;br/&gt;Hub ↔ MenuItem (one row per pair).&lt;br/&gt;Listed row absent = unlisted.&lt;br/&gt;Available = true / false is per hub.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#202B36;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1050" y="710.0" width="473.203125" height="130.0" as="geometry" />
        </mxCell>
        <mxCell id="text_4" value="&lt;div&gt;Catalogue archive never rewrites order snapshots.&lt;br/&gt;Archived brand or item cannot be ordered.&lt;br/&gt;Hub details appear in Figure 2.2A.&lt;br/&gt;Voucher → Order appears in Figure 2.2C.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#202B36;fontStyle=0;" vertex="1" parent="1">
