;endFill=1;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="delivered" target="endDelivered"><mxGeometry as="geometry" relative="1"><Array as="points" /><mxPoint as="sourcePoint" x="1025" y="170" /><mxPoint as="targetPoint" x="1054" y="170" /></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#004387;strokeWidth=2;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="failed" target="endFailed"><mxGeometry as="geometry" relative="1"><Array as="points" /><mxPoint as="sourcePoint" x="1040" y="550" /><mxPoint as="targetPoint" x="1054" y="550" /></mxGeometry></mxCell><mxCell id="out" value="OUT_FOR_DELIVERY" style="rounded=1;arcSize=20;html=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#004387;strokeWidth=2;fontSize=16;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry as="geometry" x="50.0" y="331.0" width="260" height="68" /></mxCell><mxCell id="delivered" value="DELIVERED" style="rounded=1;arcSize=20;html=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#004387;strokeWidth=2;fontSize=16;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry as="geometry" x="815.0" y="136.0" width="210" height="68" /></mxCell><mxCell id="failed" value="DELIVERY_FAILED" style="rounded=1;arcSize=20;html=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#004387;strokeWidth=2;fontSize=16;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry as="geometry" x="800.0" y="516.0" width="240" height="68" /></mxCell><mxCell id="endDelivered" value="" style="shape=endState;fillColor=#004387;strokeColor=#004387;" vertex="1" parent="1"><mxGeometry as="geometry" x="1054.0" y="156.0" width="28" height="28" /></mxCell><mxCell id="endFailed" value="" style="shape=endState;fillColor=#004387;strokeColor=#004387;" vertex="1" parent="1"><mxGeometry as="geometry" x="1054.0" y="536.0" width="28" height="28" /></mxCell><mxCell id="label0" value="confirmDelivered&#10;[assigned active shipper; COD cash = T]&#10;/ Delivery DELIVERED; set finished_at, closed_at;&#10;COD PAID; record exact cash; ONLINE stays PAID" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=white;strokeColor=none;fontSize=16;fontColor=#004387;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="385" y="210" width="410" height="100" /></mxCell><mxCell id="label1" value="reportFailure [assigned active shipper; reason]&#10;/ Delivery FAILED + reason; finished_at, closed_at;&#10;COD VOIDED or ONLINE REFUND_PENDING;&#10;ONLINE refund_amount = captured C (BR-17)" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=white;strokeColor=none;fontSize=16;fontColor=#004387;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="375" y="410" width="420" height="100" /></mxCell><mxCell id="notes" value="Views A–E project one Order lifecycle; repeated state names denote the same stored state.&#10;Every event requires an active authorised actor; failed guards change no Order facts.&#10;Terminal states: DELIVERED, DELIVERY_FAILED, REJECTED, CANCELLED; no redelivery loop." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=16;fontColor=#1B1B1B;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="638" width="1060" height="60" /></mxCell><mxCell id="author" value="Author: 722I0004 · AI-assisted (Codex)" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=16;fontColor=#004387;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="704" width="1060" height="24" /></mxCell><mxCell id="legend" value="Filled dot: initial · Bullseye: final · Grey: future/unreachable · Labels: event [guard] / effect" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=16;fontColor=#004387;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="730" width="1060" height="24" /></mxCell></root></mxGraphModel></diagram></mxfile>