metry as="geometry" x="325" y="440" width="450" height="80" /></mxCell><mxCell id="notes" value="Views A–E project one Order lifecycle; repeated state names denote the same stored state.&#10;Every event requires an active authorised actor; failed guards change no Order facts.&#10;No cancel transition exists from PREPARING or later; terminal orders cannot be revived." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=16;fontColor=#1B1B1B;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="638" width="1060" height="60" /></mxCell><mxCell id="author" value="Author: 722I0004 · AI-assisted (Codex)" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=16;fontColor=#004387;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="704" width="1060" height="24" /></mxCell><mxCell id="legend" value="Filled dot: initial · Bullseye: final · Grey: future/unreachable · Labels: event [guard] / effect" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=16;fontColor=#004387;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="730" width="1060" height="24" /></mxCell></root></mxGraphModel></diagram></mxfile>