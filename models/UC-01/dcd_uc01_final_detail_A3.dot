digraph G {
graph [rankdir=TB, nodesep=0.2, ranksep=0.34, fontname="Arial", fontsize=14, pad=0.08, dpi=200, newrank=true];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=14, arrowsize=0.9, penwidth=1.1];
labelloc="t"; labeljust="l"; label=<<B><FONT POINT-SIZE="16">UC-01 Place an order</FONT></B><BR ALIGN="LEFT"/><B><FONT POINT-SIZE="14">Final design class diagram, detail sheet A3: PlaceOrderController, data access (1 of 2)</FONT></B><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">Owner 722I0004 · Author 722I0004 · AI-assisted (Claude)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#4A5663">grey dashed: calls or uses</FONT>    <FONT POINT-SIZE="14" COLOR="#7A4FA0">purple dashed: «persists» (DAO writes the entity)</FONT>    <FONT POINT-SIZE="14" COLOR="#00796B">teal dotted: «loads» (DAO only reads it)</FONT>    <BR ALIGN="LEFT"/>>;
subgraph cluster_controller { label=<<B>Controller layer («control»)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "PlaceOrderController"; }
  "PlaceOrderController" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF5EA"><TR><TD><FONT POINT-SIZE="14"><B>PlaceOrderController</B></FONT></TD></TR></TABLE>>];
}
subgraph cluster_dao { label=<<B>Data access layer</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "HubDAO"; "PaymentDAO"; }
  { rank=same; "UserDAO"; }
  "HubDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" CELLPADDING="3"><FONT POINT-SIZE="14">«DAO»</FONT><BR/><FONT POINT-SIZE="14"><B>HubDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ active_load(hub_id: int): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ active_loads(): dict[int, int]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ get(hub_id: int): Hub | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ get_available_item(hub_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;menu_item_id:&#160;int):&#160;MenuItem&#160;|&#160;None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ get_including_archived(hub_id: int): Hub | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ list_active(): list[Hub]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ list_menu(hub_id: int): list[HubMenuItem]</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "PaymentDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" CELLPADDING="3"><FONT POINT-SIZE="14">«DAO»</FONT><BR/><FONT POINT-SIZE="14"><B>PaymentDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ get_by_order_id(order_id: int): Payment | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ insert(payment: Payment): int</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "UserDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" CELLPADDING="3"><FONT POINT-SIZE="14">«DAO»</FONT><BR/><FONT POINT-SIZE="14"><B>UserDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ get_by_id(user_id: int): UserAccount | None</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
"PlaceOrderController" -> "HubDAO" [style=invis];
"HubDAO" -> "UserDAO" [style=invis];
subgraph cluster_domain { label=<<B>Domain layer («entity»)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "Brand"; "Hub"; "HubMenuItem"; "HubStatus"; "MenuItem"; "Order"; "Payment"; "Quote"; }
  { rank=same; "UserAccount"; "Voucher"; }
  "Brand" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>Brand</B></FONT></TD></TR></TABLE>>];
  "Hub" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>Hub</B></FONT></TD></TR></TABLE>>];
  "HubMenuItem" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>HubMenuItem</B></FONT></TD></TR></TABLE>>];
  "HubStatus" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>HubStatus</B></FONT></TD></TR></TABLE>>];
  "MenuItem" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>MenuItem</B></FONT></TD></TR></TABLE>>];
  "Order" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>Order</B></FONT></TD></TR></TABLE>>];
  "Payment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>Payment</B></FONT></TD></TR></TABLE>>];
  "Quote" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>Quote</B></FONT></TD></TR></TABLE>>];
  "UserAccount" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>UserAccount</B></FONT></TD></TR></TABLE>>];
  "Voucher" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF6E0"><TR><TD><FONT POINT-SIZE="14"><B>Voucher</B></FONT></TD></TR></TABLE>>];
}
"UserDAO" -> "Brand" [style=invis];
"Brand" -> "UserAccount" [style=invis];
"HubDAO" -> "Brand" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
"HubDAO" -> "Hub" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
"HubDAO" -> "HubMenuItem" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
"HubDAO" -> "MenuItem" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
"HubDAO" -> "Order" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
"PaymentDAO" -> "Payment" [style=dashed, arrowhead=vee, color="#7A4FA0", fontcolor="#7A4FA0", xlabel="«persists»"];
"PlaceOrderController" -> "Hub" [style=dashed, arrowhead=vee, color="#4A5663"];
"PlaceOrderController" -> "HubDAO" [style=dashed, arrowhead=vee, color="#4A5663"];
"PlaceOrderController" -> "HubStatus" [style=dashed, arrowhead=vee, color="#4A5663"];
"PlaceOrderController" -> "Order" [style=dashed, arrowhead=vee, color="#4A5663"];
"PlaceOrderController" -> "PaymentDAO" [style=dashed, arrowhead=vee, color="#4A5663"];
"PlaceOrderController" -> "Quote" [style=dashed, arrowhead=vee, color="#4A5663"];
"PlaceOrderController" -> "UserDAO" [style=dashed, arrowhead=vee, color="#4A5663"];
"PlaceOrderController" -> "Voucher" [style=dashed, arrowhead=vee, color="#4A5663"];
"UserDAO" -> "UserAccount" [style=dotted, arrowhead=vee, color="#00796B", fontcolor="#00796B", xlabel="«loads»"];
}