digraph G {
graph [rankdir=LR, nodesep=0.2, ranksep=0.34, fontname="Arial", fontsize=14, pad=0.08, dpi=200, newrank=true];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=14, arrowsize=0.9, penwidth=1.1];
labelloc="t"; labeljust="l"; label=<<B><FONT POINT-SIZE="16">UC-01 Place an order</FONT></B><BR ALIGN="LEFT"/><B><FONT POINT-SIZE="14">Final design class diagram, detail sheet A1: PlaceOrderController, view and controller</FONT></B><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">Owner 722I0004 · Author 722I0004 · AI-assisted (Claude)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#4A5663">grey dashed: calls or uses</FONT>    <BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#7A4FA0">purple dashed: «persists» (DAO writes the entity)</FONT>    <BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#00796B">teal dotted: «loads» (DAO only reads it)</FONT>    <BR ALIGN="LEFT"/>>;
subgraph cluster_view { label=<<B>View layer (Flask blueprint functions)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "bp_order"; }
  "bp_order" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FA" CELLPADDING="3"><FONT POINT-SIZE="14">«boundary»</FONT><BR/><FONT POINT-SIZE="14"><B>order views</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ choose_hub() GET /order/hubs</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ choose_items() GET /order/hubs/&lt;int:hub_id&gt;</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ confirm() POST /order/confirm</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ quote() POST /order/quote</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_controller { label=<<B>Controller layer</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "PlaceOrderController"; }
  "PlaceOrderController" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#EAF5EA" CELLPADDING="3"><FONT POINT-SIZE="14">«control»</FONT><BR/><FONT POINT-SIZE="14"><B>PlaceOrderController</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ confirm_order(user_id: int, hub_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;address_id:&#160;int&#160;|&#160;None,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;quantities:&#160;Mapping[int,&#160;str],</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;idempotency_token:&#160;str,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;quoted_total:&#160;int&#160;|&#160;None,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;voucher_code:&#160;str&#160;|&#160;None,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;payment:&#160;PaymentChoice&#160;|&#160;None,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;quote_fingerprint:&#160;str&#160;|&#160;None):&#160;OrderConfirmation</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ list_hubs(): list[HubStatus]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ request_quote(user_id: int, hub_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;address_id:&#160;int&#160;|&#160;None,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;quantities:&#160;Mapping[int,&#160;str],</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;voucher_code:&#160;str&#160;|&#160;None,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;payment:&#160;PaymentChoice&#160;|&#160;None):&#160;Quote</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ select_hub(user_id: int, hub_id: int): HubMenuView</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
"bp_order" -> "PlaceOrderController" [style=invis];
"bp_order" -> "PlaceOrderController" [style=dashed, arrowhead=vee, color="#4A5663"];
}