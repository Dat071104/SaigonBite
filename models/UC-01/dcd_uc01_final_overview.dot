digraph G {
graph [rankdir=TB, nodesep=0.12, ranksep=0.24, fontname="Arial", fontsize=14, pad=0.08, dpi=200, newrank=true];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=14, arrowsize=0.9, penwidth=1.1];
labelloc="t"; labeljust="l"; label=<<B><FONT POINT-SIZE="16">UC-01 Place an order</FONT></B><BR ALIGN="LEFT"/><B><FONT POINT-SIZE="14">Final design class diagram, overview (class names only)</FONT></B><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">Owner 722I0004 · Author 722I0004 · AI-assisted (Claude)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#4A5663">grey dashed: calls or uses</FONT>    <BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#B07A00">amber: association (multiplicities in the domain model, 2.1.7)</FONT>    <BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#7A4FA0">purple dashed: «persists» (DAO writes the entity)</FONT>    <BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#00796B">teal dotted: «loads» (DAO only reads it)</FONT>    <BR ALIGN="LEFT"/>>;
subgraph cluster_view { label=<<B>View layer («boundary»)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "bp_order"; }
  "bp_order" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E8F1FA"><TR><TD><FONT POINT-SIZE="14"><B>order views</B></FONT></TD></TR></TABLE>>];
}
subgraph cluster_controller { label=<<B>Controller layer («control»)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "OrderTrackingController"; "PlaceOrderController"; }
  "OrderTrackingController" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF5EA"><TR><TD><FONT POINT-SIZE="14"><B>OrderTrackingController</B></FONT></TD></TR></TABLE>>];
  "PlaceOrderController" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF5EA"><TR><TD><FONT POINT-SIZE="14"><B>PlaceOrderController</B></FONT></TD></TR></TABLE>>];
}
"bp_order" -> "OrderTrackingController" [style=invis];
subgraph cluster_dao { label=<<B>Data access layer («DAO», «gateway»)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "CustomerDAO"; "DeliveryDAO"; "HubDAO"; "OrderDAO"; }
  { rank=same; "PaymentDAO"; "PaymentGatewaySimulator"; }
  { rank=same; "ReplacementOfferDAO"; "UserDAO"; "VoucherDAO"; }
