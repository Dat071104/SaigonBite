digraph G {
graph [rankdir=TB, nodesep=0.2, ranksep=0.34, fontname="Arial", fontsize=14, pad=0.08, dpi=200, newrank=true];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=14, arrowsize=0.9, penwidth=1.1];
labelloc="t"; labeljust="l"; label=<<B><FONT POINT-SIZE="16">UC-01 Place an order</FONT></B><BR ALIGN="LEFT"/><B><FONT POINT-SIZE="14">Final design class diagram, detail sheet A2: PlaceOrderController, controller and domain</FONT></B><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">Owner 722I0004 · Author 722I0004 · AI-assisted (Claude)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#4A5663">grey dashed: calls or uses</FONT>    <FONT POINT-SIZE="14" COLOR="#7A4FA0">purple dashed: «persists» (DAO writes the entity)</FONT>    <BR ALIGN="LEFT"/><FONT POINT-SIZE="14" COLOR="#00796B">teal dotted: «loads» (DAO only reads it)</FONT>    <BR ALIGN="LEFT"/>>;
subgraph cluster_controller { label=<<B>Controller layer («control»)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "PlaceOrderController"; }
  "PlaceOrderController" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF5EA"><TR><TD><FONT POINT-SIZE="14"><B>PlaceOrderController</B></FONT></TD></TR></TABLE>>];
}
subgraph cluster_domain { label=<<B>Domain layer (entities and value objects)</B>>; labeljust="l"; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=14; margin=5;
  { rank=same; "Hub"; "HubStatus"; }
  { rank=same; "Order"; }
  { rank=same; "Quote"; "Voucher"; }
  "Hub" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="3"><FONT POINT-SIZE="14">«entity»</FONT><BR/><FONT POINT-SIZE="14"><B>Hub</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="14">id: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">code: str</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">name: str</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ distance_to(address: Address): float</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "HubStatus" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="3"><FONT POINT-SIZE="14">«entity»</FONT><BR/><FONT POINT-SIZE="14"><B>HubStatus</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ busy(): bool</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ quiet(): bool</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "Order" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="3"><FONT POINT-SIZE="14">«entity»</FONT><BR/><FONT POINT-SIZE="14"><B>Order</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="14">state: OrderState</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">delivery_fee: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">idempotency_token: str</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">placed_at: str</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">lines: list[OrderLine]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">id: int | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">archived_at: str | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">delivery_address_text: str</FONT><BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="14">distance_km: float</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">voucher_discount: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">quiet_discount: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">reject_reason: str | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">confirmed_at: str | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">ready_at: str | None</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">closed_at: str | None</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ place(customer_id: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;quote:&#160;Quote,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;idempotency_token:&#160;str,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;placed_at:&#160;str):&#160;Order</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "Quote" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="3"><FONT POINT-SIZE="14">«entity»</FONT><BR/><FONT POINT-SIZE="14"><B>Quote</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ fingerprint(payment_method: PaymentMethod,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;online_option:&#160;OnlineOption&#160;|&#160;None):&#160;str</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ total(): int</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "Voucher" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" CELLPADDING="3"><FONT POINT-SIZE="14">«entity»</FONT><BR/><FONT POINT-SIZE="14"><B>Voucher</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="14">id: int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">code: str</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="14">+ discount_for(item_subtotal: int): int</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">+ problem(item_subtotal: int,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="14">&#160;&#160;&#160;&#160;&#160;&#160;&#160;today:&#160;str):&#160;str&#160;|&#160;None</FONT><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
"PlaceOrderController" -> "Hub" [style=invis];
"Hub" -> "Order" [style=invis];
"Order" -> "Quote" [style=invis];
"PlaceOrderController" -> "Hub" [style=dashed, arrowhead=vee, color="#4A5663"];
"PlaceOrderController" -> "HubStatus" [style=dashed, arrowhead=vee, color="#4A5663"];
"PlaceOrderController" -> "Order" [style=dashed, arrowhead=vee, color="#4A5663"];
"PlaceOrderController" -> "Quote" [style=dashed, arrowhead=vee, color="#4A5663"];
"PlaceOrderController" -> "Voucher" [style=dashed, arrowhead=vee, color="#4A5663"];
}