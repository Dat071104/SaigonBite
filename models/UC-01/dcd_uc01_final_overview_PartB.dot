digraph G {
graph [rankdir=TB, nodesep=0.15, ranksep=0.5, fontname="Arial", fontsize=16, pad=0.2, dpi=200];
node [shape=plain, fontname="Arial", fontsize=13];
edge [fontname="Arial", fontsize=12];
labelloc="t"; label=<<B>UC-01 Place an order — final design class diagram (part B: OrderTrackingController)</B><BR/><FONT POINT-SIZE="13">Owner 722I0004 · Author 722I0004 · AI-assisted (Claude) · signatures from the code at the release commit</FONT>>;
subgraph cluster_view { label=<<B>View layer (Flask blueprints, templates)</B>>; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=15;
  { rank=same; "bp_order"; }
  "bp_order" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FA" BALIGN="CENTER"><FONT POINT-SIZE="12">«boundary»</FONT><BR/><B>order views</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cancel() POST /order/&lt;int:order_id&gt;/cancel<BR ALIGN="LEFT"/>+ detail() GET /order/&lt;int:order_id&gt;<BR ALIGN="LEFT"/>+ my_orders() GET /order/mine<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_controller { label=<<B>Controller layer (one use-case controller)</B>>; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=15;
  { rank=same; "OrderTrackingController"; }
  "OrderTrackingController" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#EAF5EA" BALIGN="CENTER"><FONT POINT-SIZE="12">«control»</FONT><BR/><B>OrderTrackingController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cancel_order(user_id: int, order_id: int): OrderDetail<BR ALIGN="LEFT"/>+ get_order(user_id: int, order_id: int): OrderDetail<BR ALIGN="LEFT"/>+ list_my_orders(user_id: int): list[OrderSummary]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_domain { label=<<B>Domain layer (entities and value objects)</B>>; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=15;
  { rank=same; "Customer"; "Delivery"; "Hub"; "Order"; "OrderLine"; "Payment"; "ReplacementOffer"; "UserAccount"; }
  "Customer" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>Customer</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id: int<BR ALIGN="LEFT"/>(read only in this use case)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "Delivery" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>Delivery</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">state: DeliveryState<BR ALIGN="LEFT"/>id: int | None<BR ALIGN="LEFT"/>(read only in this use case)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "Hub" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>Hub</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id: int<BR ALIGN="LEFT"/>code: str<BR ALIGN="LEFT"/>name: str<BR ALIGN="LEFT"/>(read only in this use case)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "Order" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>Order</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">state: OrderState<BR ALIGN="LEFT"/>delivery_fee: int<BR ALIGN="LEFT"/>idempotency_token: str<BR ALIGN="LEFT"/>placed_at: str<BR ALIGN="LEFT"/>lines: list[OrderLine]<BR ALIGN="LEFT"/>id: int | None<BR ALIGN="LEFT"/>archived_at: str | None<BR ALIGN="LEFT"/>delivery_address_text: str<BR ALIGN="LEFT"/>distance_km: float<BR ALIGN="LEFT"/>voucher_discount: int<BR ALIGN="LEFT"/>quiet_discount: int<BR ALIGN="LEFT"/>reject_reason: str | None<BR ALIGN="LEFT"/>confirmed_at: str | None<BR ALIGN="LEFT"/>ready_at: str | None<BR ALIGN="LEFT"/>closed_at: str | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ move_to(new_state: OrderState): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "OrderLine" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>OrderLine</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id: int | None<BR ALIGN="LEFT"/>(read only in this use case)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "Payment" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>Payment</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">method: PaymentMethod<BR ALIGN="LEFT"/>state: PaymentState<BR ALIGN="LEFT"/>amount: int<BR ALIGN="LEFT"/>created_at: str<BR ALIGN="LEFT"/>updated_at: str | None<BR ALIGN="LEFT"/>online_option: OnlineOption | None<BR ALIGN="LEFT"/>provider_ref: str | None<BR ALIGN="LEFT"/>refund_amount: int<BR ALIGN="LEFT"/>id: int | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ release_for_unfulfilled_order(): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ReplacementOffer" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>ReplacementOffer</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">original_item_name: str<BR ALIGN="LEFT"/>original_unit_price: int<BR ALIGN="LEFT"/>new_item_name: str<BR ALIGN="LEFT"/>new_unit_price: int<BR ALIGN="LEFT"/>state: OfferState<BR ALIGN="LEFT"/>offered_at: str<BR ALIGN="LEFT"/>decided_at: str | None<BR ALIGN="LEFT"/>id: int | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "UserAccount" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>UserAccount</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id: int<BR ALIGN="LEFT"/>(read only in this use case)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
}
subgraph cluster_dao { label=<<B>Data access layer (DAO per table)</B>>; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=15;
  { rank=same; "CustomerDAO"; "DeliveryDAO"; "HubDAO"; "OrderDAO"; "PaymentDAO"; "ReplacementOfferDAO"; "UserDAO"; }
  "CustomerDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" BALIGN="CENTER"><FONT POINT-SIZE="12">«DAO»</FONT><BR/><B>CustomerDAO</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ get_by_user_id(user_id: int): Customer | None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "DeliveryDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" BALIGN="CENTER"><FONT POINT-SIZE="12">«DAO»</FONT><BR/><B>DeliveryDAO</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ get_by_order_id(order_id: int): Delivery | None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "HubDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" BALIGN="CENTER"><FONT POINT-SIZE="12">«DAO»</FONT><BR/><B>HubDAO</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ get_including_archived(hub_id: int): Hub | None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "OrderDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" BALIGN="CENTER"><FONT POINT-SIZE="12">«DAO»</FONT><BR/><B>OrderDAO</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ _load(row: sqlite3.Row | None): Order | None<BR ALIGN="LEFT"/>+ change_state(order_id: int,<BR ALIGN="LEFT"/>        from_state: OrderState,<BR ALIGN="LEFT"/>        to_state: OrderState, now: str,<BR ALIGN="LEFT"/>        reject_reason: str | None): bool<BR ALIGN="LEFT"/>+ get_by_id(order_id: int): Order | None<BR ALIGN="LEFT"/>+ list_for_customer(customer_id: int): list[Order]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "PaymentDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" BALIGN="CENTER"><FONT POINT-SIZE="12">«DAO»</FONT><BR/><B>PaymentDAO</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ change_state(order_id: int,<BR ALIGN="LEFT"/>        from_state: PaymentState,<BR ALIGN="LEFT"/>        to_state: PaymentState, now: str): bool<BR ALIGN="LEFT"/>+ get_by_order_id(order_id: int): Payment | None<BR ALIGN="LEFT"/>+ set_amounts(order_id: int, amount: int,<BR ALIGN="LEFT"/>        refund_amount: int, now: str): bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "ReplacementOfferDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" BALIGN="CENTER"><FONT POINT-SIZE="12">«DAO»</FONT><BR/><B>ReplacementOfferDAO</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ decide(offer_id: int, to_state: OfferState,<BR ALIGN="LEFT"/>        now: str): bool<BR ALIGN="LEFT"/>+ get_open(order_id: int): ReplacementOffer | None<BR ALIGN="LEFT"/>+ list_for_order(order_id: int): list[ReplacementOffer]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "UserDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" BALIGN="CENTER"><FONT POINT-SIZE="12">«DAO»</FONT><BR/><B>UserDAO</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ get_by_id(user_id: int): UserAccount | None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
