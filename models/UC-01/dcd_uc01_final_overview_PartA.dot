digraph G {
graph [rankdir=TB, nodesep=0.15, ranksep=0.5, fontname="Arial", fontsize=16, pad=0.2, dpi=200];
node [shape=plain, fontname="Arial", fontsize=13];
edge [fontname="Arial", fontsize=12];
labelloc="t"; label=<<B>UC-01 Place an order — final design class diagram (part A: PlaceOrderController)</B><BR/><FONT POINT-SIZE="13">Owner 722I0004 · Author 722I0004 · AI-assisted (Claude) · signatures from the code at the release commit</FONT>>;
subgraph cluster_view { label=<<B>View layer (Flask blueprints, templates)</B>>; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=15;
  { rank=same; "bp_order"; }
  "bp_order" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#E8F1FA" BALIGN="CENTER"><FONT POINT-SIZE="12">«boundary»</FONT><BR/><B>order views</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ choose_hub() GET /order/hubs<BR ALIGN="LEFT"/>+ choose_items() GET /order/hubs/&lt;int:hub_id&gt;<BR ALIGN="LEFT"/>+ confirm() POST /order/confirm<BR ALIGN="LEFT"/>+ quote() POST /order/quote<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_controller { label=<<B>Controller layer (one use-case controller)</B>>; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=15;
  { rank=same; "PlaceOrderController"; }
  "PlaceOrderController" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#EAF5EA" BALIGN="CENTER"><FONT POINT-SIZE="12">«control»</FONT><BR/><B>PlaceOrderController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ confirm_order(user_id: int, hub_id: int,<BR ALIGN="LEFT"/>        address_id: int | None,<BR ALIGN="LEFT"/>        quantities: Mapping[int, str],<BR ALIGN="LEFT"/>        idempotency_token: str,<BR ALIGN="LEFT"/>        quoted_total: int | None,<BR ALIGN="LEFT"/>        voucher_code: str | None,<BR ALIGN="LEFT"/>        payment: PaymentChoice | None,<BR ALIGN="LEFT"/>        quote_fingerprint: str | None): OrderConfirmation<BR ALIGN="LEFT"/>+ list_hubs(): list[HubStatus]<BR ALIGN="LEFT"/>+ request_quote(user_id: int, hub_id: int,<BR ALIGN="LEFT"/>        address_id: int | None,<BR ALIGN="LEFT"/>        quantities: Mapping[int, str],<BR ALIGN="LEFT"/>        voucher_code: str | None,<BR ALIGN="LEFT"/>        payment: PaymentChoice | None): Quote<BR ALIGN="LEFT"/>+ select_hub(user_id: int, hub_id: int): HubMenuView<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_domain { label=<<B>Domain layer (entities and value objects)</B>>; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=15;
  { rank=same; "Address"; "Brand"; "Customer"; "Hub"; "HubMenuItem"; "HubStatus"; "MenuItem"; "Order"; "OrderLine"; "Payment"; "Quote"; "UserAccount"; "Voucher"; }
  "Address" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>Address</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id: int<BR ALIGN="LEFT"/>(read only in this use case)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "Brand" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>Brand</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id: int<BR ALIGN="LEFT"/>name: str<BR ALIGN="LEFT"/>(read only in this use case)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "Customer" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>Customer</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id: int<BR ALIGN="LEFT"/>(read only in this use case)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "Hub" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>Hub</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id: int<BR ALIGN="LEFT"/>code: str<BR ALIGN="LEFT"/>name: str<BR ALIGN="LEFT"/>(read only in this use case)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ distance_to(address: Address): float<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "HubMenuItem" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>HubMenuItem</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(read only in this use case)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "HubStatus" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>HubStatus</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ busy(): bool<BR ALIGN="LEFT"/>+ quiet(): bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "MenuItem" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>MenuItem</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id: int<BR ALIGN="LEFT"/>name: str<BR ALIGN="LEFT"/>(read only in this use case)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "Order" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>Order</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">state: OrderState<BR ALIGN="LEFT"/>delivery_fee: int<BR ALIGN="LEFT"/>idempotency_token: str<BR ALIGN="LEFT"/>placed_at: str<BR ALIGN="LEFT"/>lines: list[OrderLine]<BR ALIGN="LEFT"/>id: int | None<BR ALIGN="LEFT"/>archived_at: str | None<BR ALIGN="LEFT"/>delivery_address_text: str<BR ALIGN="LEFT"/>distance_km: float<BR ALIGN="LEFT"/>voucher_discount: int<BR ALIGN="LEFT"/>quiet_discount: int<BR ALIGN="LEFT"/>reject_reason: str | None<BR ALIGN="LEFT"/>confirmed_at: str | None<BR ALIGN="LEFT"/>ready_at: str | None<BR ALIGN="LEFT"/>closed_at: str | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ place(customer_id: int, quote: Quote,<BR ALIGN="LEFT"/>        idempotency_token: str,<BR ALIGN="LEFT"/>        placed_at: str): Order<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "OrderLine" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>OrderLine</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">item_name: str<BR ALIGN="LEFT"/>unit_price: int<BR ALIGN="LEFT"/>quantity: int<BR ALIGN="LEFT"/>id: int | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "Payment" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>Payment</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">method: PaymentMethod<BR ALIGN="LEFT"/>state: PaymentState<BR ALIGN="LEFT"/>amount: int<BR ALIGN="LEFT"/>created_at: str<BR ALIGN="LEFT"/>updated_at: str | None<BR ALIGN="LEFT"/>online_option: OnlineOption | None<BR ALIGN="LEFT"/>provider_ref: str | None<BR ALIGN="LEFT"/>refund_amount: int<BR ALIGN="LEFT"/>id: int | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "Quote" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>Quote</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ fingerprint(payment_method: PaymentMethod,<BR ALIGN="LEFT"/>        online_option: OnlineOption | None): str<BR ALIGN="LEFT"/>+ total(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "UserAccount" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>UserAccount</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id: int<BR ALIGN="LEFT"/>(read only in this use case)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  "Voucher" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#FFF6E0" BALIGN="CENTER"><FONT POINT-SIZE="12">«entity»</FONT><BR/><B>Voucher</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id: int<BR ALIGN="LEFT"/>code: str<BR ALIGN="LEFT"/>(read only in this use case)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ discount_for(item_subtotal: int): int<BR ALIGN="LEFT"/>+ problem(item_subtotal: int, today: str): str | None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_dao { label=<<B>Data access layer (DAO per table)</B>>; style="rounded,filled"; fillcolor="#FAFAFA"; color="#9AA7B4"; fontsize=15;
  { rank=same; "CustomerDAO"; "HubDAO"; "OrderDAO"; "PaymentDAO"; "PaymentGatewaySimulator"; "UserDAO"; "VoucherDAO"; }
  "CustomerDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" BALIGN="CENTER"><FONT POINT-SIZE="12">«DAO»</FONT><BR/><B>CustomerDAO</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ get_address(address_id: int,<BR ALIGN="LEFT"/>        customer_id: int): Address | None<BR ALIGN="LEFT"/>+ get_by_user_id(user_id: int): Customer | None<BR ALIGN="LEFT"/>+ list_addresses(customer_id: int): list[Address]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "HubDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" BALIGN="CENTER"><FONT POINT-SIZE="12">«DAO»</FONT><BR/><B>HubDAO</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ active_load(hub_id: int): int<BR ALIGN="LEFT"/>+ active_loads(): dict[int, int]<BR ALIGN="LEFT"/>+ get(hub_id: int): Hub | None<BR ALIGN="LEFT"/>+ get_available_item(hub_id: int,<BR ALIGN="LEFT"/>        menu_item_id: int): MenuItem | None<BR ALIGN="LEFT"/>+ get_including_archived(hub_id: int): Hub | None<BR ALIGN="LEFT"/>+ list_active(): list[Hub]<BR ALIGN="LEFT"/>+ list_menu(hub_id: int): list[HubMenuItem]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "OrderDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" BALIGN="CENTER"><FONT POINT-SIZE="12">«DAO»</FONT><BR/><B>OrderDAO</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ _load(row: sqlite3.Row | None): Order | None<BR ALIGN="LEFT"/>+ get_by_id(order_id: int): Order | None<BR ALIGN="LEFT"/>+ get_by_token(token: str): Order | None<BR ALIGN="LEFT"/>+ insert(order: Order): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "PaymentDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" BALIGN="CENTER"><FONT POINT-SIZE="12">«DAO»</FONT><BR/><B>PaymentDAO</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ get_by_order_id(order_id: int): Payment | None<BR ALIGN="LEFT"/>+ insert(payment: Payment): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "PaymentGatewaySimulator" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" BALIGN="CENTER"><FONT POINT-SIZE="12">«DAO»</FONT><BR/><B>PaymentGatewaySimulator</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ authorise(amount: int,<BR ALIGN="LEFT"/>        option: OnlineOption, outcome: str): Authorisation<BR ALIGN="LEFT"/>+ release(reference: str): None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "UserDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" BALIGN="CENTER"><FONT POINT-SIZE="12">«DAO»</FONT><BR/><B>UserDAO</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ get_by_id(user_id: int): UserAccount | None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "VoucherDAO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD BGCOLOR="#F2ECF8" BALIGN="CENTER"><FONT POINT-SIZE="12">«DAO»</FONT><BR/><B>VoucherDAO</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ get_by_code(code: str): Voucher | None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
